#!/usr/bin/env python3
"""herdr-doomface-widget — draw the Doom face full-size in its own dedicated
pane, rather than compositing into someone else's corner (herdr-doomface) or
standing in as sidebar text (the $doomface token that same loop reports).
The user asked for a persistent, standalone widget; this is that.

Opened via the "doomface-widget" action / doomface-widget-action.sh as a
`[[panes]] placement = "split"` plugin pane. Herdr's docs distinguish this
from `popup` (session-modal, steals all terminal input including Escape) and
the default `overlay` (transient, restores previous focus on close): split,
tab, and zoomed plugin panes "are normal Herdr panes after they open" —
resizable, movable, and left alone until the user closes them, which is what
makes this an ambient widget rather than a dialog.

HERDR_DOOMFACE_TARGET names the *other* pane whose token usage this widget
watches. This pane's own id is only where it draws, not what it measures.

No socket compositing needed here: this process owns its pane's entire tty,
so it writes kitty graphics protocol escape codes straight to its own
stdout — the same primitive vendor/sprite.pl uses for the in-pane alert
sprite. Pixel dimensions are used explicitly rather than kitty's cell-based
c=/r= placement scaling; sprite.pl's own header explains why: an unknown
cell aspect ratio squashes a square sprite into an ellipse. CELL_W/CELL_H
below are a common monospace default, not queried from the terminal — a real
query would mean writing a CSI 16 t request and reading our own stdin for the
reply, which this pane (unlike sprite.pl, writing into a pane it doesn't own)
could actually do safely, just deferred as unnecessary for a first version.
Scaling is nearest-neighbour and integer-only (no downscale below the
source frame): pixel art turns to mush under anything else, and a pane too
small to fit even one pixel-doubled frame is a sizing problem, not a
scaling one.

Env:
  HERDR_DOOMFACE_TARGET=<pane-id>   required — whose tokens to watch
  HERDR_DOOMFACE_INTERVAL=4         seconds between polls
"""

import base64
import os
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _doomface_core import (  # noqa: E402
    herdr_pane_get, load_frame_bytes, load_manifest, pick_frame,
    remaining_pct_for_pane,
)

CELL_W = 8
CELL_H = 16
IMAGE_ID = 9100

ESC = "\033"
CSI = "\033["


def term_size_px():
    size = os.get_terminal_size()
    return max(1, size.columns - 2) * CELL_W, max(1, size.lines - 2) * CELL_H


def fit(sw, sh, max_w, max_h):
    scale = max(1, int(min(max_w / sw, max_h / sh)))
    return sw * scale, sh * scale


def scale_nearest(data, sw, sh, dw, dh):
    out = bytearray(dw * dh * 4)
    for y in range(dh):
        sy = min(sh - 1, y * sh // dh)
        src_row = sy * sw * 4
        dst_row = y * dw * 4
        for x in range(dw):
            sx = min(sw - 1, x * sw // dw)
            out[dst_row + x * 4:dst_row + x * 4 + 4] = data[src_row + sx * 4:src_row + sx * 4 + 4]
    return bytes(out)


def send_image(data, w, h):
    b64 = base64.b64encode(data).decode("ascii")
    chunks = [b64[i:i + 4000] for i in range(0, len(b64), 4000)]
    out = [f"{ESC}_Ga=d,d=I,i={IMAGE_ID},q=2{ESC}\\", f"{CSI}2J{CSI}H"]
    for i, chunk in enumerate(chunks):
        more = 1 if i < len(chunks) - 1 else 0
        ctrl = f"a=T,f=32,s={w},v={h},i={IMAGE_ID},q=2" if i == 0 else f"i={IMAGE_ID},q=2"
        out.append(f"{ESC}_G{ctrl},m={more};{chunk}{ESC}\\")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def clear_image():
    sys.stdout.write(f"{ESC}_Ga=d,d=I,i={IMAGE_ID},q=2{ESC}\\")
    sys.stdout.flush()


def show_message(text):
    sys.stdout.write(f"{CSI}2J{CSI}H{text}\n")
    sys.stdout.flush()


def main() -> int:
    target = os.environ.get("HERDR_DOOMFACE_TARGET")
    if not target:
        print("herdr-doomface-widget: HERDR_DOOMFACE_TARGET not set", file=sys.stderr)
        return 2

    interval = float(os.environ.get("HERDR_DOOMFACE_INTERVAL", "4"))

    stop = False

    def on_term(_signum, _frame):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, on_term)

    manifest = load_manifest()
    if not manifest:
        show_message("doomface: no frames cached (run the plugin's asset download step)")
        return 0

    last_frame = None
    last_size = None

    try:
        while not stop:
            pane = herdr_pane_get(target)
            if pane is None or pane.get("agent") != "claude":
                show_message(f"doomface: {target} is gone")
                break

            try:
                remaining = remaining_pct_for_pane(pane)
            except Exception:
                remaining = None

            if remaining is not None:
                frame = pick_frame(remaining)
                size = term_size_px()
                if frame != last_frame or size != last_size:
                    info = manifest.get(frame)
                    data = load_frame_bytes(frame) if info else None
                    if info and data:
                        dw, dh = fit(info["width"], info["height"], *size)
                        scaled = scale_nearest(data, info["width"], info["height"], dw, dh)
                        send_image(scaled, dw, dh)
                        last_frame, last_size = frame, size

            for _ in range(max(1, int(interval * 10))):
                if stop:
                    break
                time.sleep(0.1)
    finally:
        clear_image()

    return 0


if __name__ == "__main__":
    sys.exit(main())
